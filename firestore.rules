rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{testId} {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /palletOrders/{orderId} {
      allow read: if isValidId(orderId);
      allow create: if isValidId(orderId) && request.resource.data.palletCount >= 1;
      allow update: if isValidId(orderId);
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if true;
    }

    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
